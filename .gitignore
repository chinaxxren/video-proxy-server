# 忽略编译生成的文件
/target/
/cache/
**/*.rs.bk

# 忽略环境配置文件
.env

# 忽略日志文件
*.log

# 忽略临时文件
*.tmp
*.temp

# 忽略 IDE 配置文件
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db

# Android library build output and staged Rust libraries
/platform/android/.gradle/
/platform/android/library/build/
/platform/android/library/src/main/jniLibs/
/platform/harmony/.hvigor/
/platform/harmony/library/build/
/platform/harmony/library/libs/
/platform/harmony/library/BuildProfile.ets

# Generated iOS player POC artifacts
/dist/ios-player-poc/
/examples/ios-player-poc/MediaProxyCachePlayerPOC.xcodeproj/
